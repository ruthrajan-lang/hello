<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns:tizen="http://tizen.org/ns/widgets" xmlns="http://www.w3.org/ns/widgets" id="http://adfree.local/tube" version="1.0.1" viewmodes="maximized">
    <tizen:application id="AdFreeTube.AdFreeTube" package="AdFreeTube" required_version="3.0"/>
    <tizen:profile name="tv-samsung"/>
    <name>AdFree Tube</name>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation href="*"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <feature name="http://tizen.org/feature/web.service"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/html5.4k.support" value="true"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/use.game.mode" value="false"/>
    <tizen:service id="AdFreeTube.Injector" auto-restart="true" on-boot="false">
        <tizen:content src="service/dist/index.js"/>
        <tizen:name>Injector</tizen:name>
    </tizen:service>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
